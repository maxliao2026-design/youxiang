# 排除所有影片與大型媒體
**/*.mp4
**/*.mov
**/*.webm
**/*.ogv
**/*.avi
**/*.wmv

# 例外：首頁實際引用、已壓縮的網頁版影片（ASCII 檔名）須進 repo 才能部署
# 注意：.mov 仍全擋，避免灶腳 ProRes 母帶（68MB）意外被追蹤
!public/video/*.mp4
!public/video/*.webm

# 排除設計原始檔與壓縮包
**/*.ai
**/*.psd
**/*.zip
**/*.rar
**/*.7z

# 排除系統雜物
**/.DS_Store
**/Thumbs.db

# 排除 Next.js 與編譯產物
node_modules/
.next/
/build
/out
.vercel
*.tsbuildinfo

# 本地用：搬出去的舊資產 (給回滾用，不該進 repo)
_unused_archive/

# 本地 npm cache
npm-cache/

# 本地 IDE / 開發工具
.claude/
dev.sh
